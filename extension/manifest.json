{
  "manifest_version": 3,
  "name": "Detector de Exposición de Datos Personales",
  "version": "1.0.0",
  "description": "Analiza formularios web y detecta la exposición de datos personales usando un modelo DistilBERT en la extensión.",
  
  "permissions": [
    "activeTab",
    "scripting",
    "notifications",
    "storage",
    "tabs"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    },
    "default_title": "Detector de Datos Personales"
  },

  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://store.steampowered.com/*",
        "https://steamcommunity.com/*",
        "https://www.roblox.com/*",
        "https://www.epicgames.com/*",
        "https://accounts.epicgames.com/*",
        "https://discord.com/*"
      ],
      "js": [
        "libs/onnxruntime-web.min.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "ml/*",
        "libs/*",
        "assets/*",
        "assets/ort-wasm/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
